{
	"schemaVersion": 1,
	"id": "gradlemc",
	"version": "${version}",
	"name": "GradleMC",
	"description": "Local-first Minecraft diagnostics, reports, and performance guidance.",
	"authors": [
		"SoumyajitXD"
	],
	"contact": {
		"homepage": "https://github.com/SoumyajitXD/GradleMC",
		"sources": "https://github.com/SoumyajitXD/GradleMC"
	},
	"license": "MIT",
	"icon": "assets/gradlemc/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.soumyajit.gradlemc.GradleMC",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.soumyajit.gradlemc.client.GradleMcClient",
				"adapter": "kotlin"
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": ">=0.92.11+1.20.1",
		"fabric-language-kotlin": ">=1.13.13+kotlin.2.4.10"
	}
}
